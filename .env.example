# ------------------------------------------------------------
# VORLAGE: Diese Datei kopieren und als ".env" speichern,
# dann die echten Werte eintragen. Die .env kommt NIE auf GitHub!
# ------------------------------------------------------------

# Hopsworks (hopsworks.ai -> Account -> API Keys)
HOPSWORKS_API_KEY=dein_hopsworks_api_key
HOPSWORKS_PROJECT=dein_projektname

# Spotify (developer.spotify.com -> Dashboard -> deine App -> Settings)
SPOTIPY_CLIENT_ID=deine_client_id
SPOTIPY_CLIENT_SECRET=dein_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
